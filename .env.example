# Never commit your real .env or Telegram *.session files.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=groq
# Set to offline for Telegram login and second-account tests without an LLM key.
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.0-flash
# Separate BotFather bot used only as a private control panel; it never speaks to the manager.
CONTROL_BOT_TOKEN=
# Optional override. Normally /start from the already-authorised client account pairs automatically.
CONTROL_OWNER_ID=
# off: text only; auto: voice replies to voice messages; always: all replies voiced.
# Uses the existing Groq key. Orpheus may require accepting model terms in Groq Console.
VOICE_MODE=off
